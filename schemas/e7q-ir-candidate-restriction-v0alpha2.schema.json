{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e7q.example/schemas/e7q-ir-candidate-restriction-v0alpha2.schema.json",
  "title": "E7Q-IR bounded candidate restriction v0alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "source_family_id", "criterion", "outcome", "retained_member_ids", "excluded_member_ids", "result_family", "source_return", "message", "limitations", "restriction_id"],
  "properties": {
    "schema": {"const": "e7q.ir.candidate-restriction/v0alpha2"},
    "operation": {"const": "restrict"},
    "source_family_id": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "criterion": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "edition", "text"],
          "properties": {
            "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
            "edition": {"type": "string", "minLength": 1, "maxLength": 1024},
            "text": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        }
      ]
    },
    "outcome": {"enum": ["success", "empty", "invalid_input", "resource_limit"]},
    "retained_member_ids": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "excluded_member_ids": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "result_family": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "source_family_id", "member_ids", "family_id"],
          "properties": {
            "schema": {"const": "e7q.ir.candidate-family-subset/v0alpha1"},
            "source_family_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "member_ids": {"type": "array", "minItems": 1, "maxItems": 65536, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
            "family_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "source_return": {
      "type": "object", "additionalProperties": false, "required": ["required", "source_family_id"],
      "properties": {"required": {"const": true}, "source_family_id": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "message": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "restriction_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
