{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e7q.example/schemas/e7q-ir-candidate-family-view-v0alpha2.schema.json",
  "title": "E7Q-IR candidate-family inventory view v0alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "source_family_id", "factor_count", "member_count", "dimensions", "member_ids", "preserves", "loses", "source_return", "limitations", "view_id"],
  "properties": {
    "schema": {"const": "e7q.ir.candidate-family-view/v0alpha2"},
    "operation": {"const": "view"},
    "source_family_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "factor_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "member_count": {"type": "integer", "minimum": 1, "maximum": 65536},
    "dimensions": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"type": "string"}},
    "member_ids": {"type": "array", "minItems": 1, "maxItems": 65536, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "preserves": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "loses": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_return": {"type": "object", "additionalProperties": false, "required": ["required", "source_family_id"], "properties": {"required": {"const": true}, "source_family_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "view_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
