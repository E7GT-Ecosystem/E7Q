{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e7q.dev/schemas/ir/transformation-v0alpha1.schema.json",
  "title": "E7Q-IR Transformation Payload v0alpha1",
  "type": "object",
  "required": ["input_refs", "output_refs", "criterion", "preserves", "loses", "assumptions", "validation_status"],
  "properties": {
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "output_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "criterion": {"type": "object"},
    "preserves": {"type": "array", "items": {"type": "string"}},
    "loses": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "validation_status": {"enum": ["declared-not-verified", "validated", "failed", "not-assessed"]}
  }
}
